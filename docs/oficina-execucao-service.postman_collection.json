{
  "info": {
    "name": "oficina-execucao-service (Fase 4)",
    "description": "Catálogo, estoque e fila de execução (PostgreSQL). Direto: http://localhost:5003 · via Kong: http://localhost:32080/execucao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5003"
    },
    {
      "key": "osBaseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "servicoId",
      "value": ""
    },
    {
      "key": "pecaId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "osId",
      "value": ""
    },
    {
      "key": "orcamentoId",
      "value": ""
    },
    {
      "key": "pagamentoId",
      "value": ""
    },
    {
      "key": "execucaoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (os-service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{osBaseUrl}}/api/auth/login",
              "host": [
                "{{osBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "O token é emitido pelo os-service; o execucao-service só valida o JWT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gerente@oficina.local\",\n  \"senha\": \"Senha@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Serviços (catálogo)",
      "item": [
        {
          "name": "Cadastrar serviço",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servicos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicos"
              ]
            },
            "description": "Role: Gerente. O teste salva servicoId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Troca de amortecedor\",\n  \"descricao\": \"Par dianteiro\",\n  \"valorBase\": 350.0,\n  \"tempoEstimadoMinutos\": 90\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const j = pm.response.json();",
                  "if (j.id) pm.collectionVariables.set('servicoId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obter serviço",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servicos/{{servicoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicos",
                "{{servicoId}}"
              ]
            },
            "description": "Roles: Atendente, Gerente, Mecanico."
          }
        },
        {
          "name": "Listar serviços",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servicos?somenteAtivos=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicos"
              ],
              "query": [
                {
                  "key": "somenteAtivos",
                  "value": "true"
                }
              ]
            },
            "description": "Roles: Atendente, Gerente, Mecanico."
          }
        },
        {
          "name": "Atualizar serviço",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/servicos/{{servicoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicos",
                "{{servicoId}}"
              ]
            },
            "description": "Role: Gerente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": null,\n  \"descricao\": null,\n  \"valorBase\": 380.0,\n  \"tempoEstimadoMinutos\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Inativar serviço",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servicos/{{servicoId}}/inativar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicos",
                "{{servicoId}}",
                "inativar"
              ]
            },
            "description": "Role: Gerente."
          }
        }
      ]
    },
    {
      "name": "Peças e estoque",
      "item": [
        {
          "name": "Cadastrar peça",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas"
              ]
            },
            "description": "Role: Gerente. O teste salva pecaId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Amortecedor dianteiro\",\n  \"codigo\": \"AMT-001\",\n  \"unidade\": \"UN\",\n  \"valor\": 220.0,\n  \"quantidadeInicial\": 10,\n  \"limiteMinimo\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const j = pm.response.json();",
                  "if (j.id) pm.collectionVariables.set('pecaId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obter peça",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{pecaId}}"
              ]
            },
            "description": "Roles: Atendente, Gerente, Mecanico. Mostra quantidadeDisponivel e quantidadeReservada."
          }
        },
        {
          "name": "Listar peças",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pecas?somenteAtivas=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas"
              ],
              "query": [
                {
                  "key": "somenteAtivas",
                  "value": "true"
                }
              ]
            },
            "description": "Roles: Atendente, Gerente, Mecanico."
          }
        },
        {
          "name": "Atualizar valor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaId}}/valor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{pecaId}}",
                "valor"
              ]
            },
            "description": "Role: Gerente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"novoValor\": 240.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reabastecer estoque",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaId}}/reabastecer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{pecaId}}",
                "reabastecer"
              ]
            },
            "description": "Roles: Gerente, Atendente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 5,\n  \"referencia\": \"NF 1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Inativar peça",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaId}}/inativar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{pecaId}}",
                "inativar"
              ]
            },
            "description": "Role: Gerente."
          }
        }
      ]
    },
    {
      "name": "Execuções (fila do mecânico)",
      "item": [
        {
          "name": "Fila de execução",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes?skip=0&take=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "take",
                  "value": "20"
                }
              ]
            },
            "description": "Roles: Mecanico, Gerente. Prioridade desc, mais antigas primeiro. O teste salva o primeiro execucaoId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (Array.isArray(j) && j.length) pm.collectionVariables.set('execucaoId', j[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obter execução",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{execucaoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{execucaoId}}"
              ]
            },
            "description": "Roles: Mecanico, Gerente."
          }
        },
        {
          "name": "Iniciar",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{execucaoId}}/iniciar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{execucaoId}}",
                "iniciar"
              ]
            },
            "description": "Publica ExecucaoIniciada."
          }
        },
        {
          "name": "Registrar diagnóstico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{execucaoId}}/diagnostico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{execucaoId}}",
                "diagnostico"
              ]
            },
            "description": "Observações obrigatórias.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observacoes\": \"Amortecedor vazando óleo; troca necessária.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Finalizar",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{execucaoId}}/finalizar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{execucaoId}}",
                "finalizar"
              ]
            },
            "description": "Consome as reservas de peças e publica ExecucaoFinalizada."
          }
        },
        {
          "name": "Falhar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{execucaoId}}/falhar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{execucaoId}}",
                "falhar"
              ]
            },
            "description": "Publica ExecucaoFalhou; a Saga libera as peças e estorna.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Peça com defeito de fábrica\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
